  <PropertyGroup>
    <TargetName Condition="'$(Platform)'=='Win32'">GeDoSaTo</TargetName>
    <TargetName Condition="'$(Platform)'=='x64'">GeDoSaTo64</TargetName>
    <NvapiLib Condition="'$(Platform)'=='Win32'">ext\nvapi\x86\nvapi.lib</NvapiLib>
    <NvapiLib Condition="'$(Platform)'=='x64'">ext\nvapi\amd64\nvapi64.lib</NvapiLib>
    <!-- Microsoft's legacy D3DX (NuGet). Always the release DLL: games only have d3dx9_43.dll. -->
    <D3dxDir>packages\Microsoft.DXSDK.D3DX.9.29.952.8\build\native\</D3dxDir>
    <D3dxLibDir Condition="'$(Platform)'=='Win32'">$(D3dxDir)release\lib\x86\</D3dxLibDir>
    <D3dxLibDir Condition="'$(Platform)'=='x64'">$(D3dxDir)release\lib\x64\</D3dxLibDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>include;defs;ext;ext\minhook\include;ext\nvapi;ext\fx11\inc;$(D3dxDir)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>d3d9.lib;d3d11.lib;dxgi.lib;d3dcompiler.lib;xinput9_1_0.lib;winmm.lib;delayimp.lib;$(NvapiLib);$(D3dxLibDir)d3dx9.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <DelayLoadDLLs>d3dx9_43.dll;d3dcompiler_47.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>
  <!-- Optional: the Steam friends hook needs Valve's Steamworks SDK headers, which can't be
       redistributed with GPL source. Build with -p:SteamworksSdkDir=<sdk>\public to include it. -->
  <ItemDefinitionGroup Condition="'$(SteamworksSdkDir)'!=''">
    <ClCompile>
      <AdditionalIncludeDirectories>$(SteamworksSdkDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>GEDOSATO_STEAM_HOOK;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
